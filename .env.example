# Postgres. Em produção: a integração Neon da Vercel cria esta variável.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/portfolio
PAYLOAD_SECRET=gere-com-openssl-rand-hex-32
# URL pública, sem barra no final (canônico, sitemap e imagens de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uploads do painel num bucket do Cloudflare R2 (API S3). Sem S3_BUCKET, ficam no disco (/media).
S3_BUCKET=
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Migrations rodam sozinhas na Vercel. Fora dela, use RUN_MIGRATIONS=true só contra
# um banco gerenciado por migrations (nunca o banco de dev).
# RUN_MIGRATIONS=true
